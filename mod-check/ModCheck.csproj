<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-checks the mod's C# against the game's real assemblies (nothing is shipped from here). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Core Keeper\CoreKeeper_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\mod\DiscordPresence\Scripts\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\Pug.Other.dll" Private="false" />
    <Reference Include="$(GameManaged)\Pug.Base.dll" Private="false" />
    <Reference Include="$(GameManaged)\Pug.ECS.Components.dll" Private="false" />
    <Reference Include="$(GameManaged)\PugMod.SDK.Runtime.dll" Private="false" />
    <Reference Include="$(GameManaged)\PugMod.SDK.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Entities.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Transforms.dll" Private="false" />
    <Reference Include="$(GameManaged)\0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
